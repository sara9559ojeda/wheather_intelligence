# =====================================================================
# Weather Intelligence — plantilla de variables de entorno
# Copia este archivo a  .env  y rellena los valores.  NUNCA subas .env a git.
# =====================================================================

# --- Base de datos PostgreSQL ---
POSTGRES_USER=weather
POSTGRES_PASSWORD=cambia_esto_en_local
POSTGRES_DB=weather_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Puerto de Redis publicado en el host por docker compose (solo 127.0.0.1)
REDIS_PORT=6379
# URL que usa SQLAlchemy (driver psycopg 3). En Docker, host = "db".
# También acepta postgres:// o postgresql:// (formato de Neon/Vercel): se fuerza psycopg 3.
#   Neon (pooled): postgresql://<user>:<pass>@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://weather:cambia_esto_en_local@localhost:5432/weather_intelligence
# Pool de conexiones: "queue" (proceso de larga vida, por defecto) | "null" (serverless/Vercel)
DB_POOL_MODE=queue

# --- Ubicación del análisis ---
# Debe coincidir con backend/ml/config/location.toml (fuente de verdad).
# Se repiten aquí para que el backend no tenga que leer el TOML en runtime.
WI_LOCATION_NAME=Madrid-Barajas
WI_LOCATION_SLUG=madrid_barajas
WI_LATITUDE=40.4936
WI_LONGITUDE=-3.5668
WI_TIMEZONE=Europe/Madrid

# --- API de Anthropic (Claude) — SOLO backend, nunca frontend ---
# Sin clave: el endpoint /insights devuelve el resumen estructurado sin interpretación.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AI_CACHE_MINUTES=60        # no re-llamar a Claude si hay un análisis más nuevo
AI_MIN_GAP_MINUTES=30      # separación mínima entre generaciones automáticas (anomalías)

# --- Open-Meteo ---
# No requiere API key. Se listan las URLs por si se quiere apuntar a un self-host.
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# --- Ingesta en tiempo real ---
INGEST_INTERVAL_MINUTES=30
# Modo de ejecución. Docker/local: true (scheduler + backfill al arrancar).
# Vercel (serverless): false — la ingesta la dispara GitHub Actions (POST /api/tasks/ingest).
ENABLE_SCHEDULER=true
RUN_STARTUP_BACKFILL=true
# Token del endpoint POST /api/tasks/ingest ("Authorization: Bearer <token>").
# Vacío = endpoint deshabilitado (503). Genera uno largo, p. ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# --- Tiempo real (WebSocket /api/ws y SSE /api/stream) ---
# Vacío = bus de eventos en memoria (una sola instancia: desarrollo local, tests).
# Con valor = Redis pub/sub (varias instancias). docker compose lo fija a redis://redis:6379/0;
# en Vercel, la URL TCP de Upstash: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=
# Cierre ordenado de cada WebSocket tras N segundos (0 = sin límite). Vercel: 280.
WS_MAX_CONNECTION_SECONDS=0

# --- Login de usuarios (dashboard) ---
# Secreto de firma de los JWT. Vacío = login deshabilitado y API de datos cerrada (503).
# Genera uno largo y no lo compartas:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_TOKEN_MINUTES=720     # duración de la sesión
# Registro público desde la pantalla de login. En producción: false, y crea las
# cuentas con  python -m backend.app.create_user <email>
ALLOW_REGISTRATION=true

# --- Reentrenamiento (fase 9) ---
RETRAIN_CHECK_INTERVAL_HOURS=24     # cada cuánto se COMPRUEBA si toca reentrenar
RETRAIN_VOLUME_TRIGGER=1000         # nº de observaciones realtime nuevas que disparan el reentreno
RETRAIN_CALENDAR_DAYS=30            # o llevar este nº de días sin comprobar
RETRAIN_EPSILON=0.02                # el retador debe mejorar el RMSE al menos un 2 %
RETRAIN_DEGRADATION_THRESHOLD=1.20  # o el campeón haber empeorado un 20 % desde que se entrenó

# --- Backend / CORS ---
# Orígenes separados por comas (en producción, el dominio del frontend en Vercel)
BACKEND_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
